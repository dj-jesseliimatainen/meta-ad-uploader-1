# Copy to `.env` for local use, AND set these in your Vercel project (Settings > Environment Variables, Production).
# These are SECRETS — never commit the filled-in .env. (.gitignore already excludes it.)

# ---- Meta ----
# A Business "system user" token with scopes: ads_management, pages_manage_ads (+ business_management).
# The system user must have access to your ad account AND your Page(s). See SETUP.md step 2.
META_ACCESS_TOKEN=

# ---- Frame.io (V4, via Adobe IMS OAuth) ----
# From the Adobe Developer Console OAuth Web App you create for Frame.io. See SETUP.md step 4.
FRAMEIO_CLIENT_ID=
FRAMEIO_CLIENT_SECRET=
FRAMEIO_REFRESH_TOKEN=
FRAMEIO_ACCOUNT_ID=
# Optional: a static Frame.io access token fallback (only used if the refresh creds above are absent).
# FRAMEIO_TOKEN=
